# Neon Postgres. The Vercel ↔ Neon integration sets these automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection, used for migrations at build time. Optional.
DATABASE_URL_UNPOOLED=

# Comma-separated emails that get admin access when they sign up or log in.
ADMIN_EMAILS=you@yourcompany.com

# Set to "false" to stop the 16 sample listings being added to an empty database.
SEED_SAMPLE_DATA=true

# Optional: shown in the footer / contact page when set.
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_RERA_ORN=
