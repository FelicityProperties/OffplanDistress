# Neon Postgres. The Vercel ↔ Neon integration sets these automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection, used for migrations at build time. Optional.
DATABASE_URL_UNPOOLED=

# Owner login. ADMIN_EMAILS defaults to mouhannad@felicitypro.com; these emails can't be registered through
# the public sign-up form. Every build creates/repairs their login with ADMIN_PASSWORD (min 10 characters).
ADMIN_EMAILS=mouhannad@felicitypro.com
ADMIN_PASSWORD=

# Email notifications + password reset (https://resend.com). Without a key, notifications are in-app only.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "OffplanDistress <deals@felicitypro.com>".
EMAIL_FROM=

# Required for the daily saved-search alerts: the job refuses to run without it (Vercel Cron sends it automatically).
CRON_SECRET=

# Set to "false" to stop the 16 sample listings being added to an empty database.
SEED_SAMPLE_DATA=true

# Optional: public site URL (used in email links) and contact details shown on the site.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=mouhannad@felicitypro.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_RERA_ORN=
