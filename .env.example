# Neon Postgres. The Vercel ↔ Neon integration sets these automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection, used for migrations at build time. Optional.
DATABASE_URL_UNPOOLED=

# Owner login. ADMIN_EMAILS defaults to mouhannad@felicitypro.com; these emails can't be registered through
# the public sign-up form. Every production build creates/repairs their login with ADMIN_PASSWORD (min 10 characters).
ADMIN_EMAILS=mouhannad@felicitypro.com
ADMIN_PASSWORD=

# Email notifications + password reset (https://resend.com). Without a key, notifications are in-app only.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "OffplanDistress <deals@felicitypro.com>". In production, emails
# reach sellers and buyers only with such a sender; without it (or with Resend's onboarding@resend.dev) only the owner
# logins (ADMIN_EMAILS) still get theirs, and the admin console shows "Email is off".
EMAIL_FROM=

# Required for the daily jobs (saved-search alerts, permit expiry / ops): they refuse to run without it, and admins
# get an in-app alert (Vercel Cron sends it automatically once it is set).
CRON_SECRET=
# Optional uptime pings (e.g. Better Stack / Healthchecks.io) sent after each successful run of a daily job.
HEARTBEAT_URL=
OPS_HEARTBEAT_URL=

# Secret mixed into the anonymous daily visitor id of the visit statistics (/admin/analytics). Any long random string
# (e.g. `openssl rand -hex 32`). Optional: without it a key is derived from CRON_SECRET (else ADMIN_PASSWORD) with
# scrypt, a slow hash, so the stored ids can't be used to test password guesses quickly; with none of the three, each
# server instance picks a random key (returning visitors may then be counted once per instance). Changing it only means
# today's returning visitors are counted once more.
ANALYTICS_SALT=

# Preview builds skip migrations and sample data so a branch can never change a database shared with production.
# Set to "true" for Preview only once each preview has its own Neon branch (Vercel ↔ Neon integration setting).
PREVIEW_DB_ISOLATED=

# Set to "false" to stop the 16 sample listings being added to a brand-new database (they are never re-added once
# removed). "force" puts them back in a local database for testing; production ignores it.
SEED_SAMPLE_DATA=true

# Optional: public site URL, e.g. https://offplandistress.com (used in email links, claim links, canonical and hreflang
# URLs; defaults to the Vercel production URL). When set to the domain Vercel serves production on, production
# redirects (308) every other host name to it.
NEXT_PUBLIC_SITE_URL=
# Company and broker details. The licensed values are built into src/lib/config.ts (BRAND): phone and WhatsApp
# +971 56 352 0611, RERA ORN 33951, trade licence 1145910 (Dubai Department of Economy and Tourism), broker
# Muhannad Al Nwilati Al Masri (BRN 59244), office: Office 705, Building 12, Bay Square, Marasi Drive, Business
# Bay, Dubai. Set a variable only to override one; an empty variable keeps the built-in value. WhatsApp is
# digits only (e.g. 9715XXXXXXXX).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_RERA_ORN=
NEXT_PUBLIC_TRADE_LICENCE=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_ADDRESS_AR=
NEXT_PUBLIC_BROKER_NAME=
NEXT_PUBLIC_BROKER_NAME_AR=
NEXT_PUBLIC_BROKER_BRN=
